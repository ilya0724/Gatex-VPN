# Telegram bot that opens the cabinet (same token as the main bot)
BOT_TOKEN=
BOT_USERNAME=gatexvpn_bot

# Remnawave panel API (token with role API)
RW_API_BASE=http://127.0.0.1:3001/api
RW_API_TOKEN=

# Links shown in the cabinet; default to the bot
SUPPORT_URL=
CHANNEL_URL=https://t.me/gaatex_vpn
BUY_URL=
REFERRAL_URL=
# Text on the renew button, e.g. "от 99 ₽"; empty hides it
PRICE_FROM=

# Optional overrides for the subscription links; {shortUuid} is substituted.
# Empty SUB_URL_TEMPLATE uses subscriptionUrl from the panel.
SUB_URL_TEMPLATE=
MIRROR_URL_TEMPLATE=https://r1.fast-cloude-cdn.online/s/{shortUuid}

# Panel user tag that marks a trial subscription; empty means TRIAL (plans.py)
TRIAL_TAG=

# Bot endpoint that creates a Platega payment for a new tariff (POST /api/plan/pay).
# Empty hides nothing but makes /api/pay answer 503.
BOT_PAY_URL=

# Bot's old mini-app /api/me (auth by X-Init-Data): referral_link and referral_count.
# Empty: the cabinet builds the link itself and shows no friend count.
BOT_ME_URL=

# Bot endpoint that blacklists a removed device's HWID (POST /api/devices/revoke-hwid),
# so the subscription proxy refuses it. Empty: removal only touches the panel.
BOT_REVOKE_URL=
# 0 keeps the user's keys when a device is removed; configs already on it keep working.
REVOKE_KEYS_ON_DELETE=1
REFERRAL_BONUS_PERCENT=25

HOST=127.0.0.1
PORT=8095
